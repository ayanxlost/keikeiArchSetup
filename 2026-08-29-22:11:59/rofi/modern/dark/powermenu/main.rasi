@import "options/font.rasi"
@import "options/wallpaper.rasi"
@import "options/colors.rasi"

// PROPERTIES (Unified transparency system)
* {
    background:                  rgba(23, 14, 12, 0.7);
    background-alt:              rgba(23, 14, 12, 0.7);
    selected:                    #b89479;
}

// WINDOW (matched to first config feel)
window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600;

    enabled:                     true;
    border:                      1px solid;
    border-radius:               20px;
    border-color:                #E7C1A4;
    cursor:                      "default";

    background-color:            rgba(23, 14, 12, 0.7);
}

// MAINBOX
mainbox {
    enabled:                     true;
    border-color:                #361f29;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "message" ];
}

// INPUT BAR
inputbar {
    enabled:                     true;
    spacing:                     0px;
    padding:                     50px 80px;
    background-color:            transparent;
    children:                    [ "textbox-prompt-colon", "dummy", "prompt"];
}

dummy {
    background-color:            transparent;
}

textbox-prompt-colon {
    enabled:                     true;
    expand:                      false;
    str:                         " System";
    padding:                     12px;
    border-radius:               100%;
    text-color:                  @foreground;
    background-color:            @background-alt;
}

prompt {
    enabled:                     true;
    padding:                     12px;
    border-radius:               100%;
    text-color:                  @foreground;
    background-color:            @background-alt;
}

// LIST
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       1;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;

    spacing:                     15px;
    margin:                      15px;
    background-color:            transparent;
    cursor:                      "default";
}

// ELEMENTS
element {
    enabled:                     true;
    padding:                     30px 10px;
    border-radius:               12px;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element-text {
    font:                        "feather bold 32";
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}

element normal.normal {
    background-color:            inherit;
    text-color:                  inherit;
}

element selected.normal {
    background-color:            #b89479;
    text-color:                  #FFFFFF;
}

// MESSAGE
message {
    enabled:                     true;
    padding:                     15px;
    background-color:            @background-alt;
    text-color:                  @foreground;
}

textbox {
    background-color:            inherit;
    text-color:                  inherit;
    vertical-align:              0.5;
    horizontal-align:            0.5;
}
